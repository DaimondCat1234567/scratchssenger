{
  "version": 2,
  "name": "scratchssenger",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "msngrv11.html",
      "use": "@vercel/static"
    },
    {
      "src": "msngrv12.html",
      "use": "@vercel/static"
    },
    {
      "src": "msngrv13.html",
      "use": "@vercel/static"
    },
    {
      "src": "msngrv144.html",
      "use": "@vercel/static"
    },
    {
      "src": "desktop.html",
      "use": "@vercel/static"
    },
    {
      "src": "ICON.jpeg",
      "use": "@vercel/static"
    },
    {
      "src": "api/server/register.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/server/desktop.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/index.html"
    },
    {
      "src": "/index",
      "dest": "/index.html"
    },
    {
      "src": "/msngrv11.html",
      "dest": "/msngrv11.html"
    },
    {
      "src": "/msngrv12.html",
      "dest": "/msngrv12.html"
    },
    {
      "src": "/msngrv13.html",
      "dest": "/msngrv13.html"
    },
    {
      "src": "/msngrv144.html",
      "dest": "/msngrv144.html"
    },
    {
      "src": "/desktop.html",
      "dest": "/desktop.html"
    },
    {
      "src": "/ICON.jpeg",
      "dest": "/ICON.jpeg"
    },
    {
      "src": "/api/",
      "dest": "/api/index.js"
    },
    {
      "src": "/desktop/(.*)",
      "dest": "/api/server/desktop.js?path=$1"
    },
    {
      "src": "/api/register/",
      "dest": "/api/server/register.js"
    },
  ]
}
